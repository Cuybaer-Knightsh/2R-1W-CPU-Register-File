# ==============================================================================
# Cadence Tempus Timing Signoff Solution Script (90nm Flow)
# ==============================================================================

# 1. Path and Library Setup
# Use standard Tcl variables to ensure portability across all Cadence tool engines
set LIB_DIR "../3_synthesis/lib"
read_lib ${LIB_DIR}/slow.lib

# 2. Load Synthesized Gate-Level Netlist & Link Top Module
read_verilog ../3_synthesis/reg_file_2r1w_netlist_dft.v
set_top_module reg_file_2r1w

# 3. Read SDC Timing Constraints and Delay Annotations
read_sdc ../3_synthesis/reg_file_2r1w_generated_sdc_dft.g

# Read SDF delay annotations if generated by Genus
if {[file exists ../3_synthesis/reg_file_2r1w_generated_delays_dft.sdf]} {
    read_sdf ../3_synthesis/reg_file_2r1w_generated_delays_dft.sdf
}

# 4. Async reset and DFT Functional Mode Constraints
set_false_path -from [get_ports rst_n]
set_case_analysis 0 [get_ports SE]
set_false_path -from [get_ports {SE scan_in}]
set_false_path -to [get_ports scan_out]


# 5. Update the Timing Graph
update_timing -full

# 6. Generate Signoff Reports
file mkdir reports
report_timing -late  -max_paths 20 > reports/tempus_setup_signoff.rpt
report_timing -early -max_paths 20 > reports/tempus_hold_signoff.rpt
report_analysis_coverage > reports/tempus_coverage.rpt

puts "=========================================================="
puts "  Tempus Signoff Static Timing Analysis Complete!        "
puts "  Setup report written to reports/tempus_setup_signoff.rpt"
puts "  Hold report written to reports/tempus_hold_signoff.rpt  "
puts "=========================================================="
